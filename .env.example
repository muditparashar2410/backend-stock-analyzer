# Database Connection (SQLite in-memory default for V1, Postgres ready)
DATABASE_URL=sqlite+aiosqlite:///:memory:
# For Postgres: postgresql+asyncpg://postgres:postgres@postgres:5432/stock_ai

# LLM Provider Configuration
LLM_PROVIDER=gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash

# MCP Configuration
MCP_PROVIDER=tapetide
MCP_SERVER_URL=https://mcp.tapetide.com/mcp
TAPETIDE_API_KEY=YOUR_TAPETIDE_API_KEY_HERE

# Security & CORS
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=INFO
